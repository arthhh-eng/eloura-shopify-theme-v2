{% comment %}
  Payment methods under the buy button: the store's enabled payment icons plus a line
  about card / cash on delivery. Texts come from translations: eloura.hydra_pdp.payments.
{% endcomment %}
<div class="eloura-pdp-payments" {{ block.shopify_attributes }}>
  <p class="eloura-pdp-payments__text">{{ 'eloura.hydra_pdp.payments.cod' | t | escape }}</p>
  {%- if shop.enabled_payment_types.size > 0 -%}
    <ul class="eloura-pdp-payments__list" role="list" aria-label="{{ 'eloura.hydra_pdp.payments.label' | t | escape }}">
      {%- for type in shop.enabled_payment_types -%}
        <li class="eloura-pdp-payments__item">{{ type | payment_type_svg_tag: class: 'eloura-pdp-payments__icon' }}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% stylesheet %}
  .eloura-pdp-payments { display: grid; gap: 10px; width: 100%; }
  .eloura-pdp-payments__text { margin: 0; color: rgb(var(--color-foreground-rgb, 23 23 23) / 0.7); font-size: 0.8125rem; line-height: 1.4; }
  .eloura-pdp-payments__list { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .eloura-pdp-payments__item { display: flex; }
  .eloura-pdp-payments__icon { display: block; width: 38px; height: 24px; }
{% endstylesheet %}

{% schema %}
{
  "name": "eloura. payment methods",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "Shows the payment methods enabled in Shopify. Text comes from translations: eloura.hydra_pdp.payments." }
  ],
  "presets": [{ "name": "eloura. payment methods" }]
}
{% endschema %}
