{% liquid
  assign upsell = block.settings.product
  if upsell == blank
    assign upsell = all_products['the-complete-ritual']
  endif
  assign current_product = closest.product
  assign show_upsell = true
  if upsell == blank or upsell.id == current_product.id
    assign show_upsell = false
  endif
%}

{% if show_upsell %}
  <div class="eloura-pdp-upsell" {{ block.shopify_attributes }}>
    <a class="eloura-pdp-upsell__media" href="{{ upsell.url }}" tabindex="-1" aria-hidden="true">
      {% if upsell.featured_image != blank %}
        {{ upsell.featured_image | image_url: width: 240 | image_tag: widths: '120, 180, 240', sizes: '88px', loading: 'lazy', alt: '', class: 'eloura-pdp-upsell__image' }}
      {% endif %}
    </a>
    <div class="eloura-pdp-upsell__body">
      <p class="eloura-pdp-upsell__title">{{ 'eloura.pdp.upsell.title' | t | escape }}</p>
      <p class="eloura-pdp-upsell__line">{{ 'eloura.pdp.upsell.line' | t | escape }}</p>
      <div class="eloura-pdp-upsell__price">{% render 'price', product_resource: upsell %}</div>
      <a class="eloura-pdp-upsell__link" href="{{ upsell.url }}">{{ 'eloura.pdp.upsell.cta' | t | escape }}</a>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .eloura-pdp-upsell { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: 16px; align-items: center; width: 100%; padding: 14px; border: 1px solid rgb(var(--color-foreground-rgb, 23 23 23) / 0.12); border-radius: 16px; }
  .eloura-pdp-upsell__media { display: block; width: 88px; aspect-ratio: 1 / 1; overflow: hidden; border-radius: 12px; background: #f0efeb; }
  .eloura-pdp-upsell__image { display: block; width: 100%; height: 100%; object-fit: cover; }
  .eloura-pdp-upsell__body { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; gap: 4px; }
  .eloura-pdp-upsell__title { margin: 0; font-size: 1rem; font-weight: 600; line-height: 1.3; }
  .eloura-pdp-upsell__line { margin: 0; color: rgb(var(--color-foreground-rgb, 23 23 23) / 0.68); font-size: 0.8125rem; line-height: 1.4; }
  .eloura-pdp-upsell__price { font-size: 0.9375rem; line-height: 1.3; }
  .eloura-pdp-upsell__price [ref='priceContainer'] { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; }
  .eloura-pdp-upsell__price .price { font-weight: 600; }
  .eloura-pdp-upsell__price .compare-at-price { color: rgb(var(--color-foreground-rgb, 23 23 23) / 0.55); font-size: 0.8125rem; text-decoration: line-through; }
  .eloura-pdp-upsell__link { display: inline-flex; min-height: 44px; align-items: center; justify-content: center; margin-top: 6px; padding: 10px 18px; border: 1px solid currentColor; border-radius: 999px; color: inherit; font-size: 0.875rem; font-weight: 500; line-height: 1.2; text-decoration: none; }
  .eloura-pdp-upsell__link:hover { background: rgb(var(--color-foreground-rgb, 23 23 23)); color: rgb(var(--color-background-rgb, 255 255 255)); }
  .eloura-pdp-upsell__link:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
{% endstylesheet %}

{% schema %}
{
  "name": "eloura. ritual upsell",
  "tag": null,
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Defaults to the-complete-ritual. Hidden on this product's own page." }
  ],
  "presets": [{ "name": "eloura. ritual upsell", "settings": { "product": "the-complete-ritual" } }]
}
{% endschema %}
