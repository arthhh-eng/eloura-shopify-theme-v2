{{ 'eloura-journey.css' | asset_url | stylesheet_tag }}

<section class="eloura-journey" style="--eloura-section-bg: {{ section.settings.background }}; --eloura-section-fg: {{ section.settings.foreground }};" aria-labelledby="ElouraBenefits-{{ section.id }}">
  <div class="eloura-journey__inner">
    <p class="eloura-journey__eyebrow">{{ 'eloura.journey.benefits_eyebrow' | t | escape }}</p>
    <h2 class="eloura-journey__heading" id="ElouraBenefits-{{ section.id }}">{{ 'eloura.journey.benefits_heading' | t | escape }}</h2>
    <p class="eloura-journey__intro">{{ 'eloura.journey.benefits_intro' | t | escape }}</p>
    <div class="eloura-journey__grid">
      {% for index in (1..4) %}
        {% liquid
          assign heading_key = 'eloura.journey.benefit_' | append: index | append: '_heading'
          assign text_key = 'eloura.journey.benefit_' | append: index | append: '_text'
        %}
        <article class="eloura-journey__card">
          <h3>{{ heading_key | t | escape }}</h3>
          <p>{{ text_key | t | escape }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "eloura. core benefits",
  "tag": "section",
  "class": "eloura-benefits-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#FAF9F6" },
    { "type": "color", "id": "foreground", "label": "Text", "default": "#171717" }
  ],
  "presets": [{ "name": "eloura. core benefits" }]
}
{% endschema %}
