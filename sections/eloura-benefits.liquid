{{ 'eloura-journey.css' | asset_url | stylesheet_tag }}

{% unless template.name == 'index' or template.suffix == 'routine' %}
  {% render 'eloura-benefits-content', section_id: section.id, background: section.settings.background, foreground: section.settings.foreground %}
{% endunless %}

{% schema %}
{
  "name": "eloura. core benefits",
  "tag": "section",
  "class": "eloura-benefits-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#FAF9F6" },
    { "type": "color", "id": "foreground", "label": "Text", "default": "#171717" }
  ],
  "presets": [{ "name": "eloura. core benefits" }]
}
{% endschema %}
