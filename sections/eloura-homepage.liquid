{{ 'eloura-homepage.css' | asset_url | stylesheet_tag }}
<script src="{{ 'eloura-homepage.js' | asset_url }}" defer></script>

<div class="eloura-home" style="--eh-background: {{ section.settings.background }};" data-eloura-home data-motion="{{ section.settings.motion }}">
  {% for block in section.blocks %}
    {% liquid
      assign item = block.settings.product
      assign formula = block.settings.formula
      assign prefix = 'eloura.homepage.' | append: formula | append: '_'
      assign category_key = prefix | append: 'category'
      assign category = block.settings.category
      if category == blank
        assign category = category_key | t
      endif
      assign heading_key = prefix | append: 'heading'
      assign heading = block.settings.heading
      if heading == blank
        assign heading = heading_key | t
      endif
      assign description_key = prefix | append: 'description'
      assign description = block.settings.description
      if description == blank
        assign description = description_key | t
      endif
      assign action_key = prefix | append: 'action'
      assign action = block.settings.action
      if action == blank
        assign action = action_key | t
      endif
      assign ingredient_key = prefix | append: 'ingredient'
      assign ingredient = block.settings.ingredient
      if ingredient == blank
        assign ingredient = ingredient_key | t
      endif
      assign usage_key = prefix | append: 'usage'
      assign usage = block.settings.usage
      if usage == blank
        assign usage = usage_key | t
      endif
      assign button_key = prefix | append: 'button'
      assign button = block.settings.button
      if button == blank
        assign button = button_key | t
      endif
      assign product_url = item.url
      if product_url == blank
        assign product_url = routes.all_products_collection_url
      endif
      assign product_model = blank
      if block.settings.show_product_model and item != blank
        assign product_models = item.media | where: 'media_type', 'model'
        assign product_model = product_models.first
      endif
    %}
    <section class="eh-product eh-product--{{ formula | escape }}" aria-labelledby="ProductStory-{{ block.id }}" {{ block.shopify_attributes }}>
      <div class="eh-product__inner">
        <header class="eh-product__header" data-eh-reveal>
          <p class="eh-product__category">{{ category | escape }}</p>
          <p class="eh-product__name">{{ formula | upcase | escape }}</p>
          <h2 id="ProductStory-{{ block.id }}">{{ heading | escape }}</h2>
          <p class="eh-product__description">{{ description | escape | newline_to_br }}</p>
        </header>
        <div class="eh-product__details" data-eh-reveal>
          <article class="eh-product__detail">
            <h3>{{ 'eloura.homepage.action_label' | t | escape }}</h3>
            <p>{{ action | escape | newline_to_br }}</p>
          </article>
          <article class="eh-product__detail">
            <h3>{{ 'eloura.homepage.ingredient_label' | t | escape }}</h3>
            <p>{{ ingredient | escape | newline_to_br }}</p>
          </article>
          <article class="eh-product__detail">
            <h3>{{ 'eloura.homepage.usage_label' | t | escape }}</h3>
            <p>{{ usage | escape | newline_to_br }}</p>
          </article>
        </div>
        <a class="eh-button" href="{{ product_url | escape }}" data-eh-reveal>{{ button | escape }}</a>
        {% if block.settings.image != blank %}
          <figure class="eh-product__media" data-eh-reveal>
            {% assign image_alt = block.settings.image.alt | default: formula %}
            {{ block.settings.image | image_url: width: 2200 | image_tag: widths: '480, 750, 1000, 1400, 1800, 2200', sizes: '(min-width: 1200px) 1180px, 92vw', loading: 'lazy', alt: image_alt }}
          </figure>
        {% elsif block.settings.show_product_model and product_model != blank %}
          <div class="eh-product__media eh-product__model" data-eh-reveal>
            {{ product_model | model_viewer_tag: reveal: 'interaction', toggleable: true }}
          </div>
        {% endif %}
      </div>
    </section>
  {% endfor %}
</div>

{% schema %}
{
  "name": "eloura. product stories",
  "tag": "section",
  "class": "eloura-homepage-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Each product is presented independently. Blank text fields use the active storefront language."
    },
    { "type": "color", "id": "background", "label": "Page background", "default": "#FAF9F6" },
    { "type": "checkbox", "id": "motion", "label": "Subtle scroll reveals", "default": true }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product story",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "formula",
          "label": "Formula / default translations",
          "options": [
            { "value": "clear", "label": "CLEAR" },
            { "value": "hydra", "label": "HYDRA" },
            { "value": "barrier", "label": "BARRIER" }
          ],
          "default": "clear"
        },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Optional wide image" },
        {
          "type": "checkbox",
          "id": "show_product_model",
          "label": "Show product 3D model when available",
          "info": "Uses the first Shopify 3D model attached to the selected product. An uploaded image takes priority.",
          "default": false
        },
        { "type": "text", "id": "category", "label": "Product category", "info": "Leave blank to use the active language." },
        { "type": "text", "id": "heading", "label": "Result heading", "info": "Leave blank to use the active language." },
        { "type": "textarea", "id": "description", "label": "Description", "info": "Leave blank to use the active language." },
        { "type": "textarea", "id": "action", "label": "What it does", "info": "Leave blank to use the active language." },
        { "type": "textarea", "id": "ingredient", "label": "Key ingredient", "info": "Leave blank to use the active language." },
        { "type": "textarea", "id": "usage", "label": "How to use", "info": "Leave blank to use the active language." },
        { "type": "text", "id": "button", "label": "Button label", "info": "Leave blank to use the active language." }
      ]
    }
  ],
  "presets": [
    {
      "name": "eloura. product stories",
      "blocks": [
        { "type": "product", "settings": { "formula": "clear" } },
        { "type": "product", "settings": { "formula": "hydra" } },
        { "type": "product", "settings": { "formula": "barrier" } }
      ]
    }
  ]
}
{% endschema %}
