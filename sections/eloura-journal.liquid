{
  "name": "eloura. journal",
  "tag": "div",
  "class": "eloura-journal-section",
  "settings": [
    { "type": "paragraph", "content": "Texts come from BG / EN / RU translations (eloura.journal). Each chapter uses its built-in photo." }
  ],
  "blocks": [{
    "type": "chapter", "name": "Chapter",
    "settings": [
      { "type": "select", "id": "story", "label": "Chapter (texts, photo and colours)", "default": "toner", "options": [
        { "value": "remover", "label": "BiPhasic Make-up Remover" },
        { "value": "toner", "label": "Glycolic Acid Toner" },
        { "value": "clear", "label": "CLEAR" },
        { "value": "hydra", "label": "HYDRA" },
        { "value": "barrier", "label": "BARRIER" },
        { "value": "spf50", "label": "SPF50 Stick" }
      ] },
      { "type": "product", "id": "product", "label": "Product for the buy button" }
    ]
  }],
  "presets": [{ "name": "eloura. journal" }]
}
