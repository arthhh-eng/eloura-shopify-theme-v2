{% comment %}
  Three key ingredients on a dark background. Each ingredient sits in an outlined ring
  with the formula it belongs to; there are deliberately no percentages or study figures.
  Copy comes from the BG / EN / RU locale files (eloura_home.ingredients.*).
  The ring draws in once on scroll (CSS only, skipped for reduced motion and old browsers).
{% endcomment %}
{%- assign items = 'niacinamide,hyaluronic,ceramides' | split: ',' -%}

<section
  class="eloura-ingredients"
  style="--eki-bg: {{ section.settings.background }}; --eki-fg: {{ section.settings.foreground }};"
  aria-labelledby="ElouraIngredientsHeading-{{ section.id }}"
>
  <div class="eloura-ingredients__inner">
    <p class="eloura-ingredients__eyebrow">{{ 'eloura_home.ingredients.eyebrow' | t | escape }}</p>
    <h2 class="eloura-ingredients__heading" id="ElouraIngredientsHeading-{{ section.id }}">
      {{- 'eloura_home.ingredients.heading' | t | escape -}}
    </h2>

    <ul class="eloura-ingredients__list" role="list">
      {%- for item in items -%}
        {%- assign prefix = 'eloura_home.ingredients.' | append: item | append: '.' -%}
        <li class="eloura-ingredients__item">
          <div class="eloura-ingredients__ring" aria-hidden="true">
            <svg viewBox="0 0 120 120" focusable="false">
              <circle class="eloura-ingredients__track" cx="60" cy="60" r="56" />
              <circle class="eloura-ingredients__arc" cx="60" cy="60" r="56" pathLength="100" />
            </svg>
            <span class="eloura-ingredients__formula">{{ prefix | append: 'formula' | t }}</span>
          </div>
          <div class="eloura-ingredients__copy">
            <h3 class="eloura-ingredients__name">{{ prefix | append: 'name' | t | escape }}</h3>
            <p class="eloura-ingredients__text">{{ prefix | append: 'text' | t | escape }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .eloura-ingredients {
    overflow: clip;
    background: var(--eki-bg, #0b0b0c);
    color: var(--eki-fg, #f7f7f4);
  }

  .eloura-ingredients__inner {
    width: min(100%, 1440px);
    margin-inline: auto;
    padding: clamp(64px, 9vw, 128px) clamp(20px, 5vw, 72px);
  }

  .eloura-ingredients__eyebrow {
    margin: 0 0 18px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-align: center;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .eloura-ingredients__heading {
    max-width: 22ch;
    margin: 0 auto;
    color: inherit;
    font-size: clamp(1.9rem, 4.6vw, 3.9rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.08;
    text-align: center;
    text-wrap: balance;
  }

  .eloura-ingredients__list {
    display: grid;
    margin: clamp(40px, 6vw, 72px) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid color-mix(in srgb, var(--eki-fg, #f7f7f4) 16%, transparent);
  }

  .eloura-ingredients__item {
    display: grid;
    grid-template-columns: clamp(96px, 28vw, 128px) minmax(0, 1fr);
    align-items: center;
    gap: clamp(18px, 5vw, 32px);
    padding-block: 28px;
    border-bottom: 1px solid color-mix(in srgb, var(--eki-fg, #f7f7f4) 16%, transparent);
  }

  .eloura-ingredients__ring {
    position: relative;
    display: grid;
    width: 100%;
    aspect-ratio: 1;
    place-items: center;
  }

  .eloura-ingredients__ring svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .eloura-ingredients__ring circle {
    fill: none;
    stroke-width: 1.5;
  }

  .eloura-ingredients__track {
    stroke: color-mix(in srgb, var(--eki-fg, #f7f7f4) 18%, transparent);
  }

  /* A full, closed ring: decorative only, it does not represent a value. */
  .eloura-ingredients__arc {
    stroke: var(--eki-fg, #f7f7f4);
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
    stroke-linecap: round;
  }

  .eloura-ingredients__formula {
    position: relative;
    font-size: clamp(0.68rem, 2.6vw, 0.82rem);
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  .eloura-ingredients__name {
    margin: 0;
    color: inherit;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    overflow-wrap: break-word;
  }

  .eloura-ingredients__text {
    max-width: 44ch;
    margin: 10px 0 0;
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
    line-height: 1.6;
    opacity: 0.74;
    text-wrap: pretty;
  }

  @media screen and (min-width: 990px) {
    .eloura-ingredients__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(24px, 3vw, 48px);
      border-top: 0;
    }

    .eloura-ingredients__item {
      grid-template-columns: 1fr;
      justify-items: center;
      align-content: start;
      padding-block: 0;
      border-bottom: 0;
      text-align: center;
    }

    .eloura-ingredients__ring {
      width: clamp(150px, 13vw, 190px);
    }

    .eloura-ingredients__text {
      margin-inline: auto;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .eloura-ingredients__arc {
        animation: eloura-ring-draw linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 40%;
      }
    }
  }

  @keyframes eloura-ring-draw {
    from { stroke-dashoffset: 100; }
    to { stroke-dashoffset: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "eloura. key ingredients",
  "tag": "section",
  "class": "eloura-key-ingredients-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "paragraph", "content": "Heading, ingredient names and descriptions come from the BG / EN / RU translations (eloura_home.ingredients)." },
    { "type": "color", "id": "background", "label": "Background", "default": "#0B0B0C" },
    { "type": "color", "id": "foreground", "label": "Text", "default": "#F7F7F4" }
  ],
  "presets": [{ "name": "eloura. key ingredients" }]
}
{% endschema %}
