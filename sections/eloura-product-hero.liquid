{% liquid
  assign hero_image_alt = section.settings.image_alt
  if hero_image_alt == blank and section.settings.hero_image != blank
    assign hero_image_alt = section.settings.hero_image.alt
  endif
  if hero_image_alt == blank
    assign hero_image_alt = 'eloura.hero.photo_alt' | t
  endif
%}

<section
  id="ElouraHero-{{ section.id }}"
  class="eloura-visual-hero"
  style="
    --eloura-hero-background: {{ section.settings.background_color }};
    --eloura-hero-position: {{ section.settings.image_position }};
  "
  aria-labelledby="ElouraHeroHeading-{{ section.id }}"
>
  <div class="eloura-visual-hero__copy">
    <p class="eloura-visual-hero__eyebrow">{{ 'eloura.hero.eyebrow' | t | escape }}</p>
    <h1 class="eloura-visual-hero__heading" id="ElouraHeroHeading-{{ section.id }}">{{ 'eloura.hero.heading' | t | escape }}</h1>
    <p class="eloura-visual-hero__description">{{ 'eloura.hero.description' | t | escape }}</p>
    <a class="eloura-visual-hero__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
      {{- 'eloura.hero.button' | t | escape -}}
    </a>
  </div>
  <div class="eloura-visual-hero__media">
    {% if section.settings.hero_image != blank %}
      {{
        section.settings.hero_image
        | image_url: width: 2000
        | image_tag:
          widths: '480, 750, 900, 1200, 1600, 2000',
          sizes: '(min-width: 990px) 50vw, 100vw',
          loading: 'lazy',
          class: 'eloura-visual-hero__image',
          alt: hero_image_alt
      }}
    {% else %}
      <img
        src="{{ 'eloura-woman-hero.jpg' | asset_url }}"
        class="eloura-visual-hero__image"
        alt="{{ 'eloura.hero.photo_alt' | t | escape }}"
        width="1086"
        height="1448"
        loading="lazy"
      >
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .eloura-visual-hero {
    display: grid;
    width: 100%;
    overflow: clip;
    background: var(--eloura-hero-background, #080808);
    color: #f7f7f4;
  }

  .eloura-visual-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 16px;
    padding: 56px 24px 40px;
  }

  .eloura-visual-hero__eyebrow {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    opacity: 0.72;
  }

  .eloura-visual-hero__heading {
    margin: 0;
    max-width: 14ch;
    color: inherit;
    font-size: clamp(2.5rem, 9vw, 5.5rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .eloura-visual-hero__description {
    margin: 0;
    max-width: 38ch;
    font-size: 1rem;
    line-height: 1.55;
    opacity: 0.82;
  }

  .eloura-visual-hero__button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
    padding: 12px 28px;
    border-radius: 999px;
    background: #f7f7f4;
    color: #111213;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-decoration: none;
  }

  .eloura-visual-hero__button:hover {
    background: #ffffff;
  }

  .eloura-visual-hero__button:focus-visible {
    outline: 2px solid #f7f7f4;
    outline-offset: 4px;
  }

  .eloura-visual-hero__media {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .eloura-visual-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--eloura-hero-position, center) center;
  }

  @media screen and (min-width: 990px) {
    .eloura-visual-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
    }

    .eloura-visual-hero__copy {
      padding: clamp(48px, 6vw, 112px);
      gap: 20px;
    }

    .eloura-visual-hero__media {
      aspect-ratio: auto;
      height: min(100svh, 960px);
      min-height: 560px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .eloura-visual-hero__image {
        animation: eloura-hero-page-turn linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
        transform-origin: center top;
      }
    }
  }

  @keyframes eloura-hero-page-turn {
    from { transform: translateY(0) scale(1); }
    to { transform: translateY(-3%) scale(1.06); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "eloura. image hero",
  "tag": "section",
  "class": "eloura-product-hero-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Woman photograph"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to all products. Heading, text and button label come from the BG / EN / RU translations (eloura.hero)."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Image background",
      "default": "#080808"
    }
  ],
  "presets": [
    {
      "name": "eloura. image hero"
    }
  ]
}
{% endschema %}
