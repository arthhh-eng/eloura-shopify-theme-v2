{% liquid
  assign hero_image_alt = section.settings.image_alt
  if hero_image_alt == blank and section.settings.hero_image != blank
    assign hero_image_alt = section.settings.hero_image.alt
  endif
%}

<section
  id="ElouraHero-{{ section.id }}"
  class="eloura-visual-hero"
  style="
    --eloura-hero-background: {{ section.settings.background_color }};
    --eloura-hero-position: {{ section.settings.image_position }};
  "
>
  <div class="eloura-visual-hero__media">
    {% if section.settings.hero_image != blank %}
      {{
        section.settings.hero_image
        | image_url: width: 2400
        | image_tag:
          widths: '480, 750, 900, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          class: 'eloura-visual-hero__image',
          alt: hero_image_alt
      }}
    {% else %}
      <div class="eloura-visual-hero__placeholder" aria-hidden="true"></div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .eloura-visual-hero {
    width: 100%;
    overflow: clip;
    background: var(--eloura-hero-background, #f4f2ec);
  }

  .eloura-visual-hero__media {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .eloura-visual-hero__image,
  .eloura-visual-hero__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .eloura-visual-hero__image {
    object-fit: cover;
    object-position: var(--eloura-hero-position, center) center;
  }

  .eloura-visual-hero__placeholder {
    background:
      radial-gradient(circle at 50% 38%, rgb(255 255 255 / 75%), transparent 34%),
      linear-gradient(135deg, #f7f6f2, #e8e5de);
  }

  @media screen and (max-width: 749px) {
    .eloura-visual-hero__media {
      aspect-ratio: 3 / 4;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "eloura. image hero",
  "tag": "section",
  "class": "eloura-product-hero-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Woman photograph"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Placeholder background",
      "default": "#F4F2EC"
    }
  ],
  "presets": [
    {
      "name": "eloura. image hero"
    }
  ]
}
{% endschema %}
