{% liquid
  assign hero_image_alt = section.settings.image_alt
  if hero_image_alt == blank and section.settings.hero_image != blank
    assign hero_image_alt = section.settings.hero_image.alt
  endif
%}

<section
  id="ElouraHero-{{ section.id }}"
  class="eloura-visual-hero"
  style="
    --eloura-hero-background: {{ section.settings.background_color }};
    --eloura-hero-position: {{ section.settings.image_position }};
  "
>
  <div class="eloura-visual-hero__media">
    {% if section.settings.hero_image != blank %}
      {{
        section.settings.hero_image
        | image_url: width: 2400
        | image_tag:
          widths: '480, 750, 900, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          class: 'eloura-visual-hero__image',
          alt: hero_image_alt
      }}
    {% else %}
      <img
        src="{{ 'eloura-woman-hero.jpg' | asset_url }}"
        class="eloura-visual-hero__image"
        alt="eloura. CLEAR"
        width="1086"
        height="1448"
        loading="eager"
        fetchpriority="high"
      >
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .eloura-visual-hero {
    width: 100%;
    overflow: clip;
    background: var(--eloura-hero-background, #080808);
  }

  .eloura-visual-hero__media {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .eloura-visual-hero__image {
    display: block;
    width: 100%;
    height: 100%;
  }

  .eloura-visual-hero__image {
    object-fit: contain;
    object-position: var(--eloura-hero-position, center) center;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .eloura-visual-hero__image {
        animation: eloura-hero-page-turn linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
        transform-origin: center top;
      }
    }
  }

  @keyframes eloura-hero-page-turn {
    from { transform: translateY(0) scale(1); }
    to { transform: translateY(-3%) scale(1.06); }
  }

  @media screen and (max-width: 749px) {
    .eloura-visual-hero__media {
      aspect-ratio: 3 / 4;
    }

    .eloura-visual-hero__image {
      object-fit: cover;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "eloura. image hero",
  "tag": "section",
  "class": "eloura-product-hero-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Woman photograph"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Image background",
      "default": "#080808"
    }
  ],
  "presets": [
    {
      "name": "eloura. image hero"
    }
  ]
}
{% endschema %}
