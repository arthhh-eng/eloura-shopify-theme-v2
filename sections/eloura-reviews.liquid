{{ 'eloura-journey.css' | asset_url | stylesheet_tag }}
{{ 'eloura-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'eloura-reviews.js' | asset_url }}" defer></script>
{% liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'eloura.reviews.heading' | t
  endif
  assign empty_text = section.settings.empty_text
  if empty_text == blank
    assign empty_text = 'eloura.reviews.empty' | t
  endif
  assign review_count = 0
  for block in section.blocks
    if block.settings.enabled and block.settings.photo != blank and block.settings.title != blank and block.settings.review != blank and block.settings.customer != blank
      assign review_count = review_count | plus: 1
    endif
  endfor
%}
<section class="eloura-journey eloura-reviews" style="--eloura-section-bg: {{ section.settings.background }}; --eloura-section-fg: {{ section.settings.foreground }}; --reviews-top: {{ section.settings.padding_top }}px; --reviews-bottom: {{ section.settings.padding_bottom }}px;" aria-labelledby="ElouraReviews-{{ section.id }}">
  <div class="eloura-journey__inner">
    <h2 class="eloura-journey__heading" id="ElouraReviews-{{ section.id }}">{{ heading | escape }}</h2>
    {% if review_count == 0 %}<p class="eloura-journey__intro">{{ empty_text | escape }}</p>{% endif %}
    {% if review_count > 0 or request.design_mode %}
      <eloura-review-carousel>
        {% if request.design_mode %}<p class="eloura-reviews__editor-note">{{ 'eloura.reviews.editor_note' | t }}</p>{% endif %}
        <ul class="eloura-reviews__track" id="ReviewsTrack-{{ section.id }}" tabindex="0" aria-label="{{ heading | escape }}">
          {% for block in section.blocks %}
            {% liquid
              assign complete = false
              if block.settings.enabled and block.settings.photo != blank and block.settings.title != blank and block.settings.review != blank and block.settings.customer != blank
                assign complete = true
              endif
            %}
            {% if complete or request.design_mode %}
              <li class="eloura-reviews__card" {{ block.shopify_attributes }}>
                {% if block.settings.photo != blank %}
                  {% assign photo_alt = block.settings.photo_alt | default: block.settings.photo.alt %}
                  {{ block.settings.photo | image_url: width: 960 | image_tag: widths: '320, 480, 640, 800, 960', sizes: '(min-width: 990px) 30vw, (min-width: 750px) 44vw, 80vw', loading: 'lazy', alt: photo_alt, class: 'eloura-reviews__photo' }}
                {% else %}
                  <div class="eloura-reviews__placeholder" aria-hidden="true">{{ 'image' | placeholder_svg_tag }}</div>
                {% endif %}
                <div class="eloura-reviews__body">
                  {% unless complete %}<p class="eloura-reviews__editor-note">{{ 'eloura.reviews.draft' | t }}</p>{% endunless %}
                  <div class="eloura-reviews__rating" role="img" aria-label="{{ 'eloura.reviews.rating' | t: rating: block.settings.rating | escape }}">
                    {% for star in (1..5) %}<span aria-hidden="true">{% if star <= block.settings.rating %}★{% else %}☆{% endif %}</span>{% endfor %}
                  </div>
                  {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
                  {% if block.settings.review != blank %}<p class="eloura-reviews__text">{{ block.settings.review | escape | newline_to_br }}</p>{% endif %}
                  {% if block.settings.customer != blank %}<p class="eloura-reviews__author">{{ block.settings.customer | escape }}</p>{% endif %}
                  {% if block.settings.date != blank %}<p class="eloura-reviews__date">{{ block.settings.date | escape }}</p>{% endif %}
                </div>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
        <div class="eloura-reviews__controls" hidden>
          <button type="button" data-review-prev aria-controls="ReviewsTrack-{{ section.id }}" aria-label="{{ 'eloura.reviews.previous' | t | escape }}" disabled>←</button>
          <button type="button" data-review-next aria-controls="ReviewsTrack-{{ section.id }}" aria-label="{{ 'eloura.reviews.next' | t | escape }}">→</button>
        </div>
      </eloura-review-carousel>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "eloura. customer reviews",
  "tag": "section",
  "class": "eloura-reviews-section",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank for the BG / EN / RU default. Translate custom text with Translate & Adapt."
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Empty-state text",
      "info": "Leave blank for the BG / EN / RU default."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FAF9F6"
    },
    {
      "type": "color",
      "id": "foreground",
      "label": "Text",
      "default": "#171717"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer review",
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Publish this real review",
          "default": false,
          "info": "Published only when photo, title, text and author are complete. Obtain permission to use the review and photograph."
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Customer photograph"
        },
        {
          "type": "text",
          "id": "photo_alt",
          "label": "Photo description (alt text)"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review title"
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Review text"
        },
        {
          "type": "text",
          "id": "customer",
          "label": "Author name"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date (optional)",
          "info": "Use your preferred display format. Translate with the review."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "eloura. customer reviews",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}
