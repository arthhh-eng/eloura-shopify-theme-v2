{{ 'eloura-journey.css' | asset_url | stylesheet_tag }}
{% render 'add-to-cart-button-styles' %}

{% liquid
  assign offer = section.settings.product
  assign variant = offer.selected_or_first_available_variant
  assign form_id = 'ElouraOfferForm-' | append: section.id
%}

{% if offer != blank %}
  <section class="eloura-journey eloura-offer" style="--eloura-section-bg: {{ section.settings.background }}; --eloura-section-fg: {{ section.settings.foreground }};" aria-labelledby="ElouraOffer-{{ section.id }}">
    <div class="eloura-journey__inner eloura-offer__inner">
      <article class="eloura-offer__card">
        <a class="eloura-offer__media" href="{{ offer.url }}" tabindex="-1" aria-hidden="true">
          {% if offer.featured_image != blank %}
            {{ offer.featured_image | image_url: width: 1200 | image_tag: widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 750px) 480px, calc(100vw - 40px)', loading: 'lazy', alt: '' }}
          {% endif %}
        </a>
        <div class="eloura-offer__body">
          <h2 class="eloura-offer__title" id="ElouraOffer-{{ section.id }}">{{ offer.title | escape }}</h2>
          <p class="eloura-offer__formula">{{ 'eloura.routine.offer_formula' | t | escape }}</p>
          <p class="eloura-offer__text">{{ 'eloura.routine.offer_text' | t | escape }}</p>
          <div class="eloura-offer__price">{% render 'price', product_resource: offer %}</div>
          <div class="eloura-offer__actions">
            <product-form-component
              data-section-id="{{ section.id }}"
              data-product-id="{{ offer.id }}"
              on:submit="/handleSubmit"
              class="eloura-offer__form"
            >
              <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
              {%- form 'product', offer, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>
                <input type="hidden" name="quantity" value="{% if variant.quantity_rule.min %}{{ variant.quantity_rule.min }}{% else %}1{% endif %}">
                {% liquid
                  if variant.available
                    assign add_text = 'actions.add_to_cart' | t
                  else
                    assign add_text = 'content.product_badge_sold_out' | t
                  endif
                  render 'add-to-cart-button', add_to_cart_text: add_text, class: 'eloura-offer__button eloura-offer__button--add add-to-cart-button', can_add_to_cart: variant.available, show_icon: false, product: offer
                %}
              {%- endform -%}
            </product-form-component>
            <a class="eloura-offer__button eloura-offer__button--link" href="{{ offer.url }}">{{ 'eloura.routine.offer_view' | t | escape }}</a>
          </div>
        </div>
      </article>
    </div>
  </section>
{% endif %}

{% javascript %}
  // Open the cart drawer after a successful add from this card, even when the store-wide auto-open setting is off.
  document.addEventListener('shopify:cart:lines-update', (event) => {
    if (event.action !== 'add' || !(event.target instanceof Element) || !event.target.closest('.eloura-offer')) return;
    Promise.resolve(event.promise).then((result) => {
      if (result?.detail?.didError) return;
      const drawer = document.getElementById('cart-drawer');
      if (drawer && !drawer.isOpen) drawer.open?.();
    }).catch(() => {});
  });
{% endjavascript %}

{% stylesheet %}
  .eloura-offer__inner { padding-block-start: 0; }
  .eloura-offer__card { display: grid; grid-template-columns: minmax(0, 1fr); overflow: hidden; max-width: 960px; border: 1px solid color-mix(in srgb, var(--eloura-section-fg) 16%, transparent); border-radius: 24px; }
  .eloura-offer__media { display: block; aspect-ratio: 1 / 1; overflow: hidden; background: #f0efeb; }
  .eloura-offer__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .eloura-offer__body { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; padding: 24px 20px 26px; }
  .eloura-offer__title { margin: 0; font-size: clamp(1.6rem, 3vw, 2.4rem); font-weight: 400; letter-spacing: -0.035em; line-height: 1.1; }
  .eloura-offer__formula { margin: 12px 0 0; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; }
  .eloura-offer__text { margin: 8px 0 0; color: color-mix(in srgb, var(--eloura-section-fg) 72%, transparent); font-size: 1rem; line-height: 1.55; }
  .eloura-offer__price { margin-block-start: 18px; font-size: 1.2rem; line-height: 1.3; }
  .eloura-offer__price [ref='priceContainer'] { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; }
  .eloura-offer__price .price { color: var(--eloura-section-fg); font-weight: 700; }
  .eloura-offer__price .compare-at-price { color: color-mix(in srgb, var(--eloura-section-fg) 55%, transparent); font-size: 0.95rem; font-weight: 500; text-decoration: line-through; }
  .eloura-offer__actions { display: grid; width: 100%; gap: 12px; margin-block-start: 22px; }
  .eloura-offer__form, .eloura-offer__form form { width: 100%; margin: 0; }
  .eloura-offer .eloura-offer__button { display: inline-flex; width: 100%; min-height: 48px; align-items: center; justify-content: center; margin: 0; padding: 12px 22px; border: 1px solid var(--eloura-section-fg); border-radius: 999px; box-shadow: none; font: inherit; font-size: 0.95rem; font-weight: 500; line-height: 1.3; letter-spacing: 0; text-decoration: none; text-transform: none; cursor: pointer; }
  .eloura-offer .eloura-offer__button--add { background: var(--eloura-section-fg); color: var(--eloura-section-bg); }
  .eloura-offer .eloura-offer__button--add:hover { background: color-mix(in srgb, var(--eloura-section-fg) 86%, var(--eloura-section-bg)); }
  .eloura-offer .eloura-offer__button--add:disabled { opacity: 0.5; cursor: not-allowed; }
  .eloura-offer .eloura-offer__button--link { background: transparent; color: var(--eloura-section-fg); }
  .eloura-offer .eloura-offer__button--link:hover { background: var(--eloura-section-fg); color: var(--eloura-section-bg); }
  .eloura-offer .eloura-offer__button:focus-visible { outline: 2px solid var(--eloura-section-fg); outline-offset: 4px; }
  @media screen and (min-width: 750px) {
    .eloura-offer__card { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: stretch; }
    .eloura-offer__media { aspect-ratio: auto; min-height: 100%; }
    .eloura-offer__body { justify-content: center; padding: 48px; }
    .eloura-offer__actions { grid-template-columns: 1fr 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "eloura. ritual offer",
  "tag": "section",
  "class": "eloura-ritual-offer-section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "color", "id": "background", "label": "Background", "default": "#111315" },
    { "type": "color", "id": "foreground", "label": "Text", "default": "#F7F7F4" }
  ],
  "presets": [{ "name": "eloura. ritual offer", "settings": { "product": "the-complete-ritual" } }]
}
{% endschema %}
