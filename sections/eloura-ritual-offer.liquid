{% comment %}
  Static product card. Uses its own .eloura-ritual-card classes only:
  .eloura-offer belongs to the discount popup (assets/privacy-offer.css) and is position: fixed.
{% endcomment %}
{% liquid
  assign offer = section.settings.product
  assign variant = offer.selected_or_first_available_variant
%}

{% if offer != blank %}
  <script src="{{ 'eloura-ritual-add.js' | asset_url }}" type="module"></script>
  <div class="eloura-ritual-card-wrap" style="--erc-bg: {{ section.settings.background }}; --erc-fg: {{ section.settings.foreground }};">
    <article class="eloura-ritual-card" aria-labelledby="ElouraRitualCard-{{ section.id }}">
      <a class="eloura-ritual-card__media" href="{{ offer.url }}" tabindex="-1" aria-hidden="true">
        {% if offer.featured_image != blank %}
          {{ offer.featured_image | image_url: width: 1200 | image_tag: widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 750px) 480px, calc(100vw - 40px)', loading: 'lazy', alt: '', class: 'eloura-ritual-card__image' }}
        {% endif %}
      </a>
      <div class="eloura-ritual-card__body">
        <h2 class="eloura-ritual-card__title" id="ElouraRitualCard-{{ section.id }}">{{ offer.title | escape }}</h2>
        <p class="eloura-ritual-card__formula">{{ 'eloura.routine.offer_formula' | t | escape }}</p>
        <p class="eloura-ritual-card__text">{{ 'eloura.routine.offer_text' | t | escape }}</p>
        <div class="eloura-ritual-card__price">{% render 'price', product_resource: offer %}</div>
        <div class="eloura-ritual-card__actions">
          <eloura-ritual-add id="ElouraRitualAdd-{{ section.id }}" class="eloura-ritual-card__add">
          {%- form 'product', offer, class: 'eloura-ritual-card__form' -%}
            <input type="hidden" name="id" value="{{ variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" name="add" class="eloura-ritual-card__button eloura-ritual-card__button--add"{% unless variant.available %} disabled{% endunless %}>
              {%- if variant.available -%}
                {{ 'actions.add_to_cart' | t | escape }}
              {%- else -%}
                {{ 'content.product_badge_sold_out' | t | escape }}
              {%- endif -%}
            </button>
          {%- endform -%}
            <p class="eloura-ritual-card__error" role="status" data-ritual-error></p>
          </eloura-ritual-add>
          <a class="eloura-ritual-card__button eloura-ritual-card__button--link" href="{{ offer.url }}">{{ 'eloura.routine.offer_view' | t | escape }}</a>
        </div>
      </div>
    </article>
  </div>
{% endif %}

{% stylesheet %}
  .eloura-ritual-card-wrap { position: static; box-sizing: border-box; width: 100%; padding: 48px 20px; background: var(--erc-bg, #111315); color: var(--erc-fg, #f7f7f4); }
  .eloura-ritual-card-wrap *, .eloura-ritual-card-wrap *::before, .eloura-ritual-card-wrap *::after { box-sizing: border-box; }
  .eloura-ritual-card { position: static; display: grid; grid-template-columns: minmax(0, 1fr); width: 100%; max-width: 960px; margin: 0 auto; overflow: hidden; border: 1px solid color-mix(in srgb, var(--erc-fg, #f7f7f4) 16%, transparent); border-radius: 24px; background: var(--erc-bg, #111315); }
  .eloura-ritual-card__media { display: block; aspect-ratio: 1 / 1; overflow: hidden; background: #f0efeb; }
  .eloura-ritual-card__image { display: block; width: 100%; height: 100%; object-fit: cover; }
  .eloura-ritual-card__body { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; padding: 24px 20px 26px; }
  .eloura-ritual-card__title { margin: 0; color: inherit; font-size: clamp(1.6rem, 3vw, 2.4rem); font-weight: 400; letter-spacing: -0.035em; line-height: 1.1; }
  .eloura-ritual-card__formula { margin: 12px 0 0; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; line-height: 1.4; }
  .eloura-ritual-card__text { margin: 8px 0 0; color: color-mix(in srgb, var(--erc-fg, #f7f7f4) 72%, transparent); font-size: 1rem; line-height: 1.55; }
  .eloura-ritual-card__price { margin: 18px 0 0; font-size: 1.2rem; line-height: 1.3; }
  .eloura-ritual-card__price [ref='priceContainer'] { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; }
  .eloura-ritual-card__price .price { color: var(--erc-fg, #f7f7f4); font-weight: 700; }
  .eloura-ritual-card__price .compare-at-price { color: color-mix(in srgb, var(--erc-fg, #f7f7f4) 55%, transparent); font-size: 0.95rem; font-weight: 500; text-decoration: line-through; }
  .eloura-ritual-card__actions { display: grid; width: 100%; gap: 12px; margin: 22px 0 0; }
  .eloura-ritual-card__form { width: 100%; margin: 0; }
  .eloura-ritual-card__add { display: block; width: 100%; }
  .eloura-ritual-card__error { margin: 8px 0 0; font-size: 0.8125rem; line-height: 1.4; }
  .eloura-ritual-card__error:empty { display: none; }
  .eloura-ritual-card__button { display: flex; width: 100%; min-height: 48px; align-items: center; justify-content: center; margin: 0; padding: 12px 22px; border: 1px solid var(--erc-fg, #f7f7f4); border-radius: 999px; box-shadow: none; font: inherit; font-size: 0.95rem; font-weight: 500; line-height: 1.3; letter-spacing: 0; text-align: center; text-decoration: none; text-transform: none; cursor: pointer; appearance: none; }
  .eloura-ritual-card__button--add { background: var(--erc-fg, #f7f7f4); color: var(--erc-bg, #111315); }
  .eloura-ritual-card__button--add:hover { background: color-mix(in srgb, var(--erc-fg, #f7f7f4) 86%, var(--erc-bg, #111315)); }
  .eloura-ritual-card__button--add:disabled { opacity: 0.5; cursor: not-allowed; }
  .eloura-ritual-card__button--link { background: transparent; color: var(--erc-fg, #f7f7f4); }
  .eloura-ritual-card__button--link:hover { background: var(--erc-fg, #f7f7f4); color: var(--erc-bg, #111315); }
  .eloura-ritual-card__button:focus-visible { outline: 2px solid var(--erc-fg, #f7f7f4); outline-offset: 4px; }
  @media screen and (min-width: 750px) {
    .eloura-ritual-card-wrap { padding: 72px 40px; }
    .eloura-ritual-card { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: stretch; }
    .eloura-ritual-card__media { aspect-ratio: auto; min-height: 100%; }
    .eloura-ritual-card__body { justify-content: center; padding: 48px; }
    .eloura-ritual-card__actions { grid-template-columns: 1fr 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "eloura. ritual card",
  "tag": "section",
  "class": "eloura-ritual-card-section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "color", "id": "background", "label": "Background", "default": "#111315" },
    { "type": "color", "id": "foreground", "label": "Text", "default": "#F7F7F4" }
  ],
  "presets": [{ "name": "eloura. ritual card", "settings": { "product": "the-complete-ritual" } }]
}
{% endschema %}
