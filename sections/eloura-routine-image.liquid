{% liquid
  assign desktop_image = section.settings.desktop_image | default: section.settings.mobile_image
  assign mobile_image = section.settings.mobile_image | default: desktop_image
  assign image_alt = section.settings.image_alt | default: desktop_image.alt
  if image_alt == blank
    assign image_alt = 'eloura.routine.image_alt' | t
  endif
%}

{{ 'eloura-journey.css' | asset_url | stylesheet_tag }}

<div class="eloura-routine-image">
  <div class="eloura-routine-image__inner">
    {% if desktop_image != blank %}
      <picture>
        {% if section.settings.mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 550 }} 550w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1000 }} 1000w"
            sizes="100vw"
          >
        {% endif %}
        {{ desktop_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1800, 2400', sizes: '(min-width: 1440px) 1440px, 100vw', loading: 'lazy', class: 'eloura-routine-image__photo', alt: image_alt }}
      </picture>
    {% else %}
      <img
        class="eloura-routine-image__photo"
        src="{{ 'eloura-routine-frosted-coast.jpg' | file_url }}"
        alt="{{ 'eloura.routine.image_alt' | t | escape }}"
        width="1122"
        height="1402"
        loading="eager"
        fetchpriority="high"
      >
    {% endif %}
    <a class="eloura-routine-image__scroll" href="#ElouraBenefitsSection-{{ section.id }}" aria-label="{{ 'eloura.journey.benefits_eyebrow' | t | escape }}">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 4v16m-6-6 6 6 6-6" />
      </svg>
    </a>
  </div>
</div>

{% render 'eloura-benefits-content', section_id: section.id, background: '#FAF9F6', foreground: '#171717' %}
{% render 'eloura-routine-intro-content', section_id: section.id %}

{% stylesheet %}
  .eloura-routine-image { background: #243747; }
  .eloura-routine-image__inner { position: relative; width: 100%; height: calc(100svh - var(--eloura-routine-image-top, 110px)); overflow: hidden; }
  .eloura-routine-image picture { display: block; height: 100%; }
  .eloura-routine-image__photo { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .eloura-routine-image__scroll { position: absolute; inset-inline-start: 50%; bottom: 22px; transform: translateX(-50%); display: grid; place-items: center; width: 50px; height: 50px; border: 1px solid #fffa; border-radius: 50%; background: #171717bd; color: #fff; text-decoration: none; box-shadow: 0 3px 12px #0004; z-index: 1; }
  .eloura-routine-image__scroll:hover { background: #383838; }
  .eloura-routine-image__scroll:focus-visible { outline: 2px solid #171717; outline-offset: 4px; }
  .eloura-routine-image-section .eloura-journey { scroll-margin-top: 110px; }
  @media (prefers-reduced-motion: no-preference) { html:has(.eloura-routine-image__scroll) { scroll-behavior: smooth; } }
  @media screen and (min-width: 750px) { .eloura-routine-image__photo { object-fit: contain; } }
  html.eloura-routine-image-locked { overflow: hidden; }
{% endstylesheet %}

{% javascript %}
  const initRoutineImage = () => {
    document.querySelectorAll('.eloura-routine-image-section').forEach((section) => {
      if (section.dataset.routineImageReady === 'true') return;
      section.dataset.routineImageReady = 'true';
      const arrow = section.querySelector('.eloura-routine-image__scroll');
      const updateHeight = () => {
        section.style.setProperty('--eloura-routine-image-top', `${Math.max(0, section.getBoundingClientRect().top + window.scrollY)}px`);
      };
      updateHeight();
      window.addEventListener('resize', updateHeight, { passive: true });
      if (!document.body.classList.contains('shopify-design-mode') && !window.location.hash && window.scrollY < 10) {
        document.documentElement.classList.add('eloura-routine-image-locked');
      }
      arrow?.addEventListener('click', () => {
        document.documentElement.classList.remove('eloura-routine-image-locked');
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') document.documentElement.classList.remove('eloura-routine-image-locked');
      });
    });
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRoutineImage, { once: true });
  } else {
    initRoutineImage();
  }
{% endjavascript %}

{% schema %}
{
  "name": "eloura. routine photo",
  "tag": "section",
  "class": "eloura-routine-image-section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop photograph" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile photograph (optional)" },
    { "type": "text", "id": "image_alt", "label": "Image description for accessibility" }
  ],
  "presets": [{ "name": "eloura. routine photo" }]
}
{% endschema %}
