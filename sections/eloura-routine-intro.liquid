{{ 'eloura-journey.css' | asset_url | stylesheet_tag }}

{% unless template.suffix == 'routine' %}
  {% render 'eloura-routine-intro-content', section_id: section.id %}
{% endunless %}

{% schema %}
{
  "name": "eloura. routine intro",
  "tag": "section",
  "class": "eloura-routine-intro-section",
  "enabled_on": { "templates": ["page"] },
  "settings": [],
  "presets": [{ "name": "eloura. routine intro" }]
}
{% endschema %}
