{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px; --marquee-duration: {{ section.settings.marquee_duration | default: 36 }}s;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  <div class="announcement-bar__marquee" role="region" aria-label="{{ 'eloura.announcement.label' | t }}">
    <div class="announcement-bar__track">
      <div class="announcement-bar__group">
        <span class="announcement-bar__message">{{ 'eloura.announcement.free_shipping_99' | t }}</span>
        <span class="announcement-bar__message">{{ 'eloura.announcement.first_order_discount' | t }}</span>
        <span class="announcement-bar__message">{{ 'eloura.announcement.everyday_care' | t }}</span>
      </div>
      <div class="announcement-bar__group" aria-hidden="true">
        <span class="announcement-bar__message">{{ 'eloura.announcement.free_shipping_99' | t }}</span>
        <span class="announcement-bar__message">{{ 'eloura.announcement.first_order_discount' | t }}</span>
        <span class="announcement-bar__message">{{ 'eloura.announcement.everyday_care' | t }}</span>
      </div>
    </div>
  </div>
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
    background: #111111 !important;
    min-height: 34px;
    display: flex;
    align-items: center;
    overflow: hidden;

    @media screen and (min-width: 750px) {
      min-height: 40px;
    }
  }

  .announcement-bar__marquee {
    width: 100%;
    overflow: hidden;
    color: #ffffff;

    @media (hover: hover) and (pointer: fine) {
      &:hover .announcement-bar__track {
        animation-play-state: paused;
      }
    }
  }

  .announcement-bar__track {
    display: flex;
    width: max-content;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
    will-change: transform;
    animation: eloura-announcement-marquee var(--marquee-duration) linear infinite;
    -webkit-animation: eloura-announcement-marquee var(--marquee-duration) linear infinite;
  }

  .announcement-bar__group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
    padding-inline-end: clamp(3rem, 8vw, 7rem);
  }

  .announcement-bar__message {
    flex-shrink: 0;
    font-family: var(--font-body--family);
    font-size: clamp(0.6875rem, 2.75vw, 0.8125rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: clamp(0.04em, 0.2vw, 0.12em);
    white-space: nowrap;
  }

  @keyframes eloura-announcement-marquee {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @-webkit-keyframes eloura-announcement-marquee {
    to {
      -webkit-transform: translate3d(-50%, 0, 0);
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__track {
      width: 100%;
      animation: none;
      -webkit-animation: none;
      transform: none;
      will-change: auto;
    }

    .announcement-bar__group {
      width: 100%;
      justify-content: center;
      padding-inline-end: 0;
    }

    .announcement-bar__group[aria-hidden='true'],
    .announcement-bar__message:not(:first-child) {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "marquee_duration",
      "label": "Ticker speed",
      "min": 24,
      "max": 60,
      "step": 2,
      "default": 38,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
