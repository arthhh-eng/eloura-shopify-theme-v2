{%- comment -%}
  Eloura language switcher: a compact square button with the current language's
  flag and code; opens a small menu with the other languages (flag + native name).
  Flags are inline SVGs (Windows doesn't render flag emoji).

  @param {string} id - Unique suffix for element ids
  @param {string} [placement] - 'down' (default) or 'up' (menu opens above the button)
{%- endcomment -%}
{%- liquid
  assign placement = placement | default: 'down'
  assign current_code = localization.language.iso_code | downcase
-%}

{%- capture flag_bg -%}
  <svg class="eloura-lang__flag" viewBox="0 0 4 3" aria-hidden="true" focusable="false"><rect width="4" height="1" fill="#fff"/><rect y="1" width="4" height="1" fill="#00966E"/><rect y="2" width="4" height="1" fill="#D62612"/></svg>
{%- endcapture -%}
{%- capture flag_ru -%}
  <svg class="eloura-lang__flag" viewBox="0 0 4 3" aria-hidden="true" focusable="false"><rect width="4" height="1" fill="#fff"/><rect y="1" width="4" height="1" fill="#0039A6"/><rect y="2" width="4" height="1" fill="#D52B1E"/></svg>
{%- endcapture -%}
{%- capture flag_en -%}
  <svg class="eloura-lang__flag" viewBox="0 0 60 30" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false"><clipPath id="eloura-uk-{{ id }}"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z"/></clipPath><path d="M0,0 v30 h60 v-30 z" fill="#012169"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/><path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#eloura-uk-{{ id }})" stroke="#C8102E" stroke-width="4"/><path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/><path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"/></svg>
{%- endcapture -%}

<eloura-language-switcher class="eloura-lang eloura-lang--{{ placement }}">
  {%- form 'localization', class: 'eloura-lang__form', return_to: back -%}
    <details class="eloura-lang__details">
      <summary
        class="eloura-lang__button"
        aria-label="{{ 'content.language' | t }}: {{ localization.language.endonym_name | capitalize }}"
      >
        <span class="eloura-lang__flag-wrap">
          {%- case current_code -%}
            {%- when 'bg' -%}{{ flag_bg }}
            {%- when 'ru' -%}{{ flag_ru }}
            {%- when 'en' -%}{{ flag_en }}
          {%- endcase -%}
        </span>
        <span class="eloura-lang__code">{{ current_code | upcase }}</span>
      </summary>

      <ul class="eloura-lang__menu" role="list">
        {%- for language in localization.available_languages -%}
          {%- liquid
            assign code = language.iso_code | downcase
            if code == current_code
              continue
            endif
            case code
              when 'bg'
                assign name = 'Български'
              when 'ru'
                assign name = 'Русский'
              when 'en'
                assign name = 'English'
              else
                assign name = language.endonym_name | capitalize
            endcase
          -%}
          <li>
            <button
              type="submit"
              name="language_code"
              value="{{ language.iso_code }}"
              lang="{{ language.iso_code }}"
              class="eloura-lang__option"
            >
              <span class="eloura-lang__flag-wrap">
                {%- case code -%}
                  {%- when 'bg' -%}{{ flag_bg }}
                  {%- when 'ru' -%}{{ flag_ru }}
                  {%- when 'en' -%}{{ flag_en }}
                {%- endcase -%}
              </span>
              <span>{{ name }}</span>
            </button>
          </li>
        {%- endfor -%}
      </ul>
    </details>
  {%- endform -%}
</eloura-language-switcher>

<script>
  if (!customElements.get('eloura-language-switcher')) {
    customElements.define(
      'eloura-language-switcher',
      class extends HTMLElement {
        connectedCallback() {
          this.details = this.querySelector('details');
          this.onDocClick = (e) => {
            if (this.details.open && !this.contains(e.target)) this.details.open = false;
          };
          this.onKey = (e) => {
            if (e.key === 'Escape' && this.details.open) {
              this.details.open = false;
              this.querySelector('summary').focus();
            }
          };
          document.addEventListener('click', this.onDocClick);
          this.addEventListener('keydown', this.onKey);
        }
        disconnectedCallback() {
          document.removeEventListener('click', this.onDocClick);
        }
      }
    );
  }
</script>

{% stylesheet %}
  .eloura-lang {
    position: relative;
    display: inline-flex;
    color: var(--color-foreground);
  }

  .eloura-lang__form {
    margin: 0;
  }

  .eloura-lang__details {
    position: relative;
  }

  .eloura-lang__button {
    list-style: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 36px;
    min-width: 36px;
    padding: 0 9px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    border-radius: 8px;
    cursor: pointer;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1;
    user-select: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .eloura-lang__button::-webkit-details-marker {
    display: none;
  }

  .eloura-lang__button:hover,
  .eloura-lang__details[open] .eloura-lang__button {
    border-color: rgb(var(--color-foreground-rgb) / 0.45);
  }

  .eloura-lang__button:focus-visible,
  .eloura-lang__option:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .eloura-lang__flag-wrap {
    position: relative;
    display: inline-flex;
    width: 20px;
    height: 15px;
    flex: none;
    border-radius: 3px;
    overflow: hidden;
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.18), 0 1px 1.5px rgb(0 0 0 / 0.12);
  }

  /* Soft sheen so the flags read like Apple emoji flags */
  .eloura-lang__flag-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgb(255 255 255 / 0.22) 0%,
      rgb(255 255 255 / 0) 35%,
      rgb(0 0 0 / 0.06) 65%,
      rgb(255 255 255 / 0.1) 100%
    );
    pointer-events: none;
  }

  .eloura-lang__flag {
    display: block;
    width: 100%;
    height: 100%;
  }

  .eloura-lang__menu {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 30;
    min-width: 160px;
    margin: 0;
    padding: 6px;
    list-style: none;
    background: var(--color-background);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 10px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.1);
  }

  .eloura-lang--up .eloura-lang__menu {
    top: auto;
    bottom: calc(100% + 8px);
    right: auto;
    left: 0;
  }

  .eloura-lang__option {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 12px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 14px;
    text-align: left;
    cursor: pointer;
  }

  .eloura-lang__option:hover {
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }
