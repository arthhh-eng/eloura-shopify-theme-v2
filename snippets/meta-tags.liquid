{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign seo_brand = 'eloura.'
  assign seo_page_title = page_title | default: shop.name | strip

  if request.page_type == 'index'
    assign seo_title = 'eloura.seo.home_title' | t
  else
    if current_tags
      capture seo_current_tags
        echo current_tags | join: ', '
      endcapture
      assign seo_page_title = seo_page_title | append: ' – tagged "' | append: seo_current_tags | append: '"'
    endif

    if current_page != 1
      assign seo_page_title = seo_page_title | append: ' – Page ' | append: current_page
    endif

    assign seo_page_title_normalized = seo_page_title | downcase | strip
    if seo_page_title_normalized == 'eloura' or seo_page_title_normalized == 'eloura.'
      assign seo_title = seo_brand
    elsif seo_page_title_normalized contains 'eloura'
      assign seo_title = seo_page_title
    else
      assign seo_title = seo_page_title | append: ' | ' | append: seo_brand
    endif
  endif

  if request.page_type == 'index'
    assign seo_description = 'eloura.seo.home_description' | t
  else
    assign seo_description = page_description
    assign seo_description_is_fallback = false

    if seo_description == blank
      case request.page_type
        when 'product'
          assign seo_description = product.description
        when 'collection'
          assign seo_description = collection.description
        when 'page'
          assign seo_description = page.content
        when 'article'
          assign seo_description = article.excerpt_or_content
      endcase

      if seo_description != blank
        assign seo_description_is_fallback = true
      endif
    endif

    if seo_description == blank
      assign seo_description = 'eloura.seo.home_description' | t
    endif

    assign seo_description = seo_description | strip_html | strip_newlines | strip
    if seo_description_is_fallback
      assign seo_description = seo_description | truncate: 155
    endif
  endif

  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>{{ seo_title | escape }}</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

<meta
  name="description"
  content="{{ seo_description | escape }}"
>
